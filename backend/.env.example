LLM_GW_API_KEY=your_api_key_here
LLM_GW_URL=http://llm-gw.jd.local/v1/chat/completions
EVAL_CONCURRENCY=1
LLM_MIN_INTERVAL_S=1.0
EVAL_MAX_ROWS=10000

# ---------------- 账号体系 ----------------
# 初始管理员账号（仅首次启动建库时生效；之后请在管理后台改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 会话签名密钥；不设置则自动生成并持久化到 data/.secret_key
# SECRET_KEY=请填一段随机字符串
# 会话有效期（秒），默认 7 天
# AUTH_TOKEN_TTL_S=604800
