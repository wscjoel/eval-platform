# 客服AI评测台 systemd 服务
# 安装：
#   sudo cp deploy/eval-platform.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now eval-platform
# 查看日志：
#   journalctl -u eval-platform -f
#
# 注意：如部署路径/用户不同，请修改 WorkingDirectory、ExecStart、User。

[Unit]
Description=Eval Platform (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
# ← 替换为实际部署用户
User=deploy
# ← 替换为实际部署路径
WorkingDirectory=/opt/eval-platform/backend
EnvironmentFile=/opt/eval-platform/backend/.env
ExecStart=/opt/eval-platform/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

# 资源与安全限制
LimitNOFILE=65536
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
